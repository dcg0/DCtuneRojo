{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "DC TuneR Rojo Studio",
    "version": "0.1.0-nightly",
    "identifier": "com.dctune.studio",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "DC TuneR Rojo Studio - Free and Open Source Tuning Suite",
                "width": 1280,
                "height": 800,
                "minWidth": 900,
                "minHeight": 600,
                "resizable": true,
                "center": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": [
            "appimage",
            "deb",
            "dmg",
            "app",
            "nsis",
            "msi"
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "resources": [
            "resources/*"
        ],
        "linux": {
            "appimage": {
                "bundleMediaFramework": false
            }
        },
        "windows": {
            "nsis": {
                "installerIcon": "icons/icon.ico"
            }
        }
    }
}
